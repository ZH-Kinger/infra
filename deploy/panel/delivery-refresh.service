# 云权限面板数据刷新（由 delivery-refresh.timer 触发）
# 安装：复制到 /etc/systemd/system/，改 WorkingDirectory、EnvironmentFile、User 后
# /opt/infra 要归 User 所有：否则 git 的 safe.directory 检查失败，写盘守卫拿不到 .gitignore 判断
#   systemctl daemon-reload && systemctl enable --now delivery-refresh.timer
[Unit]
Description=Cloud permission panel data refresh
Wants=network-online.target
After=network-online.target
# 进程自己发不出告警的情况（崩溃、超时被杀、导入失败）由这个单元兜底，私聊管理员。
# **必须写在 [Unit] 段**：原先那行注释掉的 OnFailure 写在 [Service] 里，取消注释也不生效
OnFailure=delivery-unit-failed@%n.service

[Service]
Type=oneshot
# 75 = 上一次还在跑，本次跳过，不算失败
#  3 = 跑完了、发现了问题、告警已经送到。算正常结束 —— 否则 OnFailure 会就同一件事再发一条
SuccessExitStatus=3 75
User=delivery
WorkingDirectory=/opt/infra
# 只读云凭证、飞书通讯录应用、告警机器人；文件权限 600
EnvironmentFile=/etc/delivery/refresh.env
Environment=PYTHONPATH=/opt/infra/src
# 提案选项要和手动生成时一致，见 README「定时刷新数据」
# **`--directory feishu` 不能省。** 不带它默认是 `--directory none`，
# 只用本地已有的映射，名册会从 219 人塌回 55 人 —— 而少掉的人表现为
# 「没有 union_id」，和权限没配长得一模一样，查起来毫无线索。
ExecStart=/usr/bin/python3 -m delivery.cli refresh --trust-unverified-when-derivable --directory feishu
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/infra/identity
TimeoutStartSec=30min
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
