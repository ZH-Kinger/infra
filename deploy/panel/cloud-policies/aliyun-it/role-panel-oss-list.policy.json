{
  "_note": "只能看清单，不能下载内容",
  "Version": "1",
  "Statement": [
    {
      "Action": [
        "oss:ListBuckets"
      ],
      "Resource": [
        "acs:oss:*:*:*"
      ],
      "Effect": "Allow"
    },
    {
      "Action": [
        "oss:GetBucketInfo",
        "oss:GetBucketStat",
        "oss:GetBucketAcl"
      ],
      "Resource": [
        "acs:oss:*:*:wuji-bucket-hangzhou",
        "acs:oss:*:*:wuji-rl-dataset",
        "acs:oss:*:*:rl-data",
        "acs:oss:*:*:wuji-datasets-hz-6c661af0",
        "acs:oss:*:*:wuji-ego-processed",
        "acs:oss:*:*:wuji-egocentric-processed",
        "acs:oss:*:*:ai-prod-wj-wl-oss",
        "acs:oss:*:*:data-factorys",
        "acs:oss:*:*:wuji-test-data",
        "acs:oss:*:*:wuji-bangkok"
      ],
      "Effect": "Allow"
    },
    {
      "Action": [
        "oss:ListObjects",
        "oss:GetBucketMultipartUploads"
      ],
      "Resource": [
        "acs:oss:*:*:wuji-bucket-hangzhou",
        "acs:oss:*:*:wuji-rl-dataset",
        "acs:oss:*:*:rl-data",
        "acs:oss:*:*:wuji-datasets-hz-6c661af0",
        "acs:oss:*:*:wuji-ego-processed",
        "acs:oss:*:*:wuji-egocentric-processed",
        "acs:oss:*:*:ai-prod-wj-wl-oss",
        "acs:oss:*:*:data-factorys",
        "acs:oss:*:*:wuji-test-data",
        "acs:oss:*:*:wuji-bangkok"
      ],
      "Effect": "Allow"
    },
    {
      "Action": [
        "oss:DeleteObject",
        "oss:DeleteObjectVersion",
        "oss:DeleteBucket",
        "oss:PutBucketAcl",
        "oss:PutObjectAcl"
      ],
      "Resource": [
        "acs:oss:*:*:*"
      ],
      "Effect": "Deny"
    },
    {
      "Action": [
        "oss:*"
      ],
      "Resource": [
        "acs:oss:*:*:cri-*",
        "acs:oss:*:*:cri-*/*"
      ],
      "Effect": "Deny"
    }
  ]
}
