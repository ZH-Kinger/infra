[Unit]
Description=Cloud panel: sync approvals, revoke expired grants
After=network-online.target
Wants=network-online.target
# 崩溃 / 超时被杀 / 非零退出时私聊管理员 —— 任务自己发不出告警的那几种情况
OnFailure=delivery-unit-failed@%n.service

[Service]
# 3 = 跑完了、某张单子有问题、已经打印也已经记进单子（待办页上看得到）。
# 不声明成正常结束的话，一分钟一轮的定时器会把一张办不了的单子变成一分钟一条私聊 ——
# 而兜底告警的原文是「异常退出，没来得及出报告」，一句真话都没有。
SuccessExitStatus=3

Type=oneshot
User=delivery
WorkingDirectory=/opt/infra
EnvironmentFile=/etc/delivery/panel.env
Environment=PYTHONPATH=/opt/infra/src
ExecStart=/usr/bin/python3 -m delivery.cli requests sweep \
  --tickets identity/tickets.json --templates identity/request-templates.json \
  --approval identity/approval.json --people identity/people.json \
  --manual identity/manual-links.json \
  --proposal identity/sso-map.proposal.json --policies identity/policies.json \
  --iam-attributes identity/iam-attributes.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/infra/identity
CapabilityBoundingSet=
