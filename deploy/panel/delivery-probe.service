# 云权限面板：外部探活 —— 那几个自建服务的地址还打得开吗
#
# **为什么需要它**：2026-09-24 那台 MLflow 机器的公网 IP 掉了，整机从外面失联
# （ping/22/80/443 全不通），而**没有任何地方会告诉你**。是用户来问「怎么打不开」
# 才发现的。这类故障的共同点是"服务自己没崩、所以自己发不出告警"。
#
# 它自己不发通知：探失败就退非零，交给 OnFailure 那条管道 —— 和其它定时任务
# 同一个出口，也就共用同一份 6 小时冷却，不会刷屏。
[Unit]
Description=Cloud panel: probe self-hosted service URLs from outside
After=network-online.target
Wants=network-online.target
OnFailure=delivery-unit-failed@%n.service

[Service]
Type=oneshot
User=delivery
WorkingDirectory=/opt/infra
EnvironmentFile=/etc/delivery/panel.env
Environment=PYTHONPATH=/opt/infra/src
# 地址列表走 DELIVERY_PROBE_URLS（panel.env 里配，逗号或空白分隔）。
# --fails 3 配合 5 分钟的定时器 = 连挂约 15 分钟才报，短暂抖动不惊动人
ExecStart=/usr/bin/python3 -m delivery.cli probe --fails 3 --timeout 10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 连续失败次数记在 /var/lib/delivery/probe-state.json。
# **和 delivery-unit-failed 的告警冷却不是同一个文件** —— 共用过一版，
# 问题是丢更新：探活读了状态、花十几秒挨个发 HTTP、再写回去，
# 而这中间告警很可能刚写过冷却时间戳，一写就被顶回旧值 → 冷却失效、开始刷屏
StateDirectory=delivery
# **地址数 × --timeout 要明显小于这个值**。超了 systemd 会杀掉进程，
# 而计数是最后一行才落盘的 —— 于是连号永远攒不够、告警永远不响，
# 同时你还会收到一条"单元没跑成"，把人引去查错方向。
# 5min / 10s = 30 个地址的余量，iam-remind 用的也是 5min
TimeoutStartSec=5min
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
