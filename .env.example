# 飞书应用（多云交付控制台，cli_xxxxxxxxxxxxxxxx）
# secret 放 .env.local（已 gitignore），绝不进这个文件、绝不进仓库
DELIVERY_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# DELIVERY_FEISHU_APP_SECRET=  见 .env.local

# 面板对外地址。部署到服务器时**必填**：访问凭证的查看地址（/c/<申请单号>#<密钥>）
# 靠它拼，拼不出来（或指向本机）就一律不受理凭证申请 —— 本机地址发出去使用方打不开。
# 面板和定时任务（delivery requests sweep）的环境里都要有。
# DELIVERY_BASE_URL=

# 采集器读两朵云的权限快照，只读凭证即可
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# VOLCANO_ACCESS_KEY=
# VOLCANO_SECRET_KEY=

# 公司 IAM 登录（面板挂在 oauth2-proxy 后面），见 deploy/panel/README.md
# DELIVERY_AUTH=proxy
# DELIVERY_PROXY_SECRET_FILE=
# DELIVERY_IAM_USERINFO_URL=
# DELIVERY_IAM_EMAIL_DOMAINS=wuji.tech
# DELIVERY_LOGOUT_URL=/oauth2/sign_out

# 定时刷新告警：飞书群自定义机器人，必须开启签名校验
# DELIVERY_ALERT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/
# DELIVERY_ALERT_SECRET=

# 申请状态通知（面板和 delivery requests sweep 都读）：设 1 开启
#   申请人：飞书应用机器人私信（需上面的应用凭证 + https 的 DELIVERY_BASE_URL，应用开 im:message:send_as_bot）
#   管理员：开通失败发到上面的告警机器人群（需 DELIVERY_ALERT_WEBHOOK）
# DELIVERY_NOTIFY=1
