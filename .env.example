# 飞书应用（多云交付控制台，cli_xxxxxxxxxxxxxxxx）
# secret 放 .env.local（已 gitignore），绝不进这个文件、绝不进仓库
DELIVERY_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# DELIVERY_FEISHU_APP_SECRET=  见 .env.local

# 部署到服务器时覆盖；本地留空即 http://localhost:8765
# DELIVERY_BASE_URL=

# 采集器读两朵云的权限快照，只读凭证即可
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# VOLCANO_ACCESS_KEY=
# VOLCANO_SECRET_KEY=
